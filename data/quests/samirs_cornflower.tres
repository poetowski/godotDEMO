[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://src/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://src/quests/quest_step.gd" id="2_step"]

[sub_resource type="Resource" id="Resource_pick"]
script = ExtResource("2_step")
text = "Pick a cornflower in the meadow in sector B1."
item = &"cornflower"
amount = 1

[sub_resource type="Resource" id="Resource_bring"]
script = ExtResource("2_step")
text = "Bring the cornflower to Samir at the oasis."

[resource]
script = ExtResource("1_quest")
id = &"samirs_cornflower"
title = "A Flower for the Fever"
giver = "Samir"
description = "Samir's daughter lies sick with a fever in his tent at the oasis. He trusts the old remedy: the petals of a blue cornflower, steeped in water, to cool it."
steps = Array[ExtResource("2_step")]([SubResource("Resource_pick"), SubResource("Resource_bring")])

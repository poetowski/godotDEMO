extends SceneTree
## Collects every English string the player can read into
## locale/messages.pot: the literals passed to tr, tr_n,
## TranslationServer.translate and translate_plural, Text.mark and
## Text.marks in src/, and the names, descriptions and facts of the items in
## data/items/. Run it with `npm run strings` after changing any text; a test
## fails while the file is out of date.

const OUTPUT := "res://locale/messages.pot"
const SOURCES := "res://src"
const ITEMS := "res://data/items"
## A GDScript string literal; its text, still escaped, is group 1.
const STRING := "\"((?:[^\"\\\\]|\\\\.)*)\""


func _initialize() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUTPUT.get_base_dir()))
	var file := FileAccess.open(OUTPUT, FileAccess.WRITE)
	file.store_string(catalog())
	file.close()
	print("[strings] wrote %s" % OUTPUT)
	quit()


## The whole .pot file, the same every time for the same sources.
static func catalog() -> String:
	var singles: Dictionary[String, PackedStringArray] = {}
	var plurals: Dictionary[String, String] = {}
	var one := RegEx.create_from_string("\\b(?:tr|TranslationServer\\.translate|Text\\.mark)\\(\\s*" + STRING)
	var many := RegEx.create_from_string("\\b(?:tr_n|TranslationServer\\.translate_plural)\\(\\s*" + STRING + "\\s*,\\s*" + STRING)
	var list := RegEx.create_from_string("\\bText\\.marks\\(\\s*PackedStringArray\\(\\[([^\\]]*)\\]")
	var literal := RegEx.create_from_string(STRING)
	for path in _scripts(SOURCES):
		var source := FileAccess.get_file_as_string(path)
		var where := path.trim_prefix("res://")
		for found in one.search_all(source):
			_add(singles, found.get_string(1), where)
		for found in many.search_all(source):
			_add(singles, found.get_string(1), where)
			plurals[found.get_string(1)] = found.get_string(2)
		for found in list.search_all(source):
			for item in literal.search_all(found.get_string(1)):
				_add(singles, item.get_string(1), where)
	for file_name in DirAccess.get_files_at(ITEMS):
		if not file_name.ends_with(".tres"):
			continue
		var item := load(ITEMS.path_join(file_name)) as ItemData
		if item == null:
			continue
		var where := ITEMS.path_join(file_name).trim_prefix("res://")
		for text: String in [item.display_name, item.description]:
			_add(singles, _escape(text), where)
		for label: String in item.facts:
			_add(singles, _escape(label), where)
			_add(singles, _escape(item.facts[label]), where)
	var lines: PackedStringArray = [
		"# Every English string the player can read. Generated by",
		"# tools/extract_strings.gd (npm run strings); don't edit by hand.",
		"msgid \"\"",
		"msgstr \"\"",
		"\"Content-Type: text/plain; charset=UTF-8\\n\"",
		"",
	]
	var ids := singles.keys()
	ids.sort()
	for id: String in ids:
		if id.is_empty():
			continue
		var places := singles[id]
		places.sort()
		lines.append("#: " + " ".join(places))
		lines.append("msgid \"%s\"" % id)
		if plurals.has(id):
			lines.append("msgid_plural \"%s\"" % plurals[id])
			lines.append("msgstr[0] \"\"")
			lines.append("msgstr[1] \"\"")
		else:
			lines.append("msgstr \"\"")
		lines.append("")
	return "\n".join(lines)


static func _add(singles: Dictionary[String, PackedStringArray], id: String, where: String) -> void:
	if not singles.has(id):
		singles[id] = PackedStringArray()
	if not singles[id].has(where):
		singles[id].append(where)


## Text from a resource, written as a .pot string literal.
static func _escape(text: String) -> String:
	return text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\t", "\\t")


## Every .gd file under a folder.
static func _scripts(folder: String) -> PackedStringArray:
	var found := PackedStringArray()
	for file_name in DirAccess.get_files_at(folder):
		if file_name.ends_with(".gd"):
			found.append(folder.path_join(file_name))
	for directory in DirAccess.get_directories_at(folder):
		found.append_array(_scripts(folder.path_join(directory)))
	return found
